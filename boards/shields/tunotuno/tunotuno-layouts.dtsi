// See https://zmk.dev/docs/development/hardware-integration/physical-layouts
// for how to configure this.


// See https://zmk.dev/docs/development/hardware-integration/physical-layouts
// for how to configure this.
//
// NOTE: x/y below is a simple ortholinear placeholder grid derived only from
// the logical (row, col) matrix position (NOT real PCB/keycap coordinates,
// which aren't finalized yet). The ORDER of entries matches default_transform's
// map exactly (Raw0 left->right, Raw1, Raw2, Raw3) -- that order is what
// matters for correct firmware operation. Adjust x/y/rot later to reflect the
// real physical layout (column stagger, thumb-cluster fan-out, etc.) -- this
// only affects the ZMK Studio visual editor, not firmware behavior.
// Units: 100 = 1u (one standard keycap width/height). Gap of 0.25u inserted
// between the two halves for readability.

#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0   0   0   0>  // Raw0 left Col0
            , <&key_physical_attrs 100 100  100    0   0   0   0>  // Raw0 left Col1
            , <&key_physical_attrs 100 100  200    0   0   0   0>  // Raw0 left Col2
            , <&key_physical_attrs 100 100  300    0   0   0   0>  // Raw0 left Col3
            , <&key_physical_attrs 100 100  400    0   0   0   0>  // Raw0 left Col4
            , <&key_physical_attrs 100 100  500    0   0   0   0>  // Raw0 left Col5
            , <&key_physical_attrs 100 100  625    0   0   0   0>  // Raw0 right Col0
            , <&key_physical_attrs 100 100  725    0   0   0   0>  // Raw0 right Col1
            , <&key_physical_attrs 100 100  825    0   0   0   0>  // Raw0 right Col2
            , <&key_physical_attrs 100 100  925    0   0   0   0>  // Raw0 right Col3
            , <&key_physical_attrs 100 100 1025    0   0   0   0>  // Raw0 right Col4
            , <&key_physical_attrs 100 100 1125    0   0   0   0>  // Raw0 right Col5
            , <&key_physical_attrs 100 100 1225    0   0   0   0>  // Raw0 right Col6
            , <&key_physical_attrs 100 100    0  100   0   0   0>  // Raw1 left Col0
            , <&key_physical_attrs 100 100  100  100   0   0   0>  // Raw1 left Col1
            , <&key_physical_attrs 100 100  200  100   0   0   0>  // Raw1 left Col2
            , <&key_physical_attrs 100 100  300  100   0   0   0>  // Raw1 left Col3
            , <&key_physical_attrs 100 100  400  100   0   0   0>  // Raw1 left Col4
            , <&key_physical_attrs 100 100  500  100   0   0   0>  // Raw1 left Col5
            , <&key_physical_attrs 100 100  625  100   0   0   0>  // Raw1 right Col0
            , <&key_physical_attrs 100 100  725  100   0   0   0>  // Raw1 right Col1
            , <&key_physical_attrs 100 100  825  100   0   0   0>  // Raw1 right Col2
            , <&key_physical_attrs 100 100  925  100   0   0   0>  // Raw1 right Col3
            , <&key_physical_attrs 100 100 1025  100   0   0   0>  // Raw1 right Col4
            , <&key_physical_attrs 100 100 1125  100   0   0   0>  // Raw1 right Col5
            , <&key_physical_attrs 100 100 1225  100   0   0   0>  // Raw1 right Col6
            , <&key_physical_attrs 100 100    0  200   0   0   0>  // Raw2 left Col0
            , <&key_physical_attrs 100 100  100  200   0   0   0>  // Raw2 left Col1
            , <&key_physical_attrs 100 100  200  200   0   0   0>  // Raw2 left Col2
            , <&key_physical_attrs 100 100  300  200   0   0   0>  // Raw2 left Col3
            , <&key_physical_attrs 100 100  400  200   0   0   0>  // Raw2 left Col4
            , <&key_physical_attrs 100 100  500  200   0   0   0>  // Raw2 left Col5
            , <&key_physical_attrs 100 100  625  200   0   0   0>  // Raw2 right Col0
            , <&key_physical_attrs 100 100  725  200   0   0   0>  // Raw2 right Col1
            , <&key_physical_attrs 100 100  825  200   0   0   0>  // Raw2 right Col2
            , <&key_physical_attrs 100 100  925  200   0   0   0>  // Raw2 right Col3
            , <&key_physical_attrs 100 100 1025  200   0   0   0>  // Raw2 right Col4
            , <&key_physical_attrs 100 100 1125  200   0   0   0>  // Raw2 right Col5
            , <&key_physical_attrs 100 100 1225  200   0   0   0>  // Raw2 right Col6
            , <&key_physical_attrs 100 100    0  300   0   0   0>  // Raw3 left Col0
            , <&key_physical_attrs 100 100  100  300   0   0   0>  // Raw3 left Col1
            , <&key_physical_attrs 100 100  200  300   0   0   0>  // Raw3 left Col2
            , <&key_physical_attrs 100 100  300  300   0   0   0>  // Raw3 left Col3
            , <&key_physical_attrs 100 100  400  300   0   0   0>  // Raw3 left Col4
            , <&key_physical_attrs 100 100  500  300   0   0   0>  // Raw3 left Col5
            , <&key_physical_attrs 100 100  625  300   0   0   0>  // Raw3 right Col0 (SW4)
            , <&key_physical_attrs 100 100  725  300   0   0   0>  // Raw3 right Col1 (S1.5)
            , <&key_physical_attrs 100 100  825  300   0   0   0>  // Raw3 right Col2 (S1.4)
            , <&key_physical_attrs 100 100  925  300   0   0   0>  // Raw3 right Col3 (S1.2)
            , <&key_physical_attrs 100 100 1025  300   0   0   0>  // Raw3 right Col4 (S1.1)
            , <&key_physical_attrs 100 100 1125  300   0   0   0>  // Raw3 right Col5 (S1.3)
            ;
    };
};