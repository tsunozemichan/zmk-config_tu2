// tunotuno: charlieplex key scan (both halves).
// GPIO pins are defined per side in tunotuno_left.overlay / tunotuno_right.overlay.
//
// Charlieplex RC(row, col): row = driving pin index, col = receiving pin index
// (index into the "gpios" list of the overlay).

#include <dt-bindings/zmk/matrix_transform.h>
#include "tunotuno-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;
    };

    // TEMPORARY: right half only (27 keys). Left half will be added later.
    // Key order follows the original right-hand layout:
    //   row0: SW1  SW5  SW8  SW11 SW14 SW17 SW20
    //   row1: SW2  SW6  SW9  SW12 SW15 SW18 SW21
    //   row2: SW3  SW7  SW10 SW13 SW16 SW19 SW22
    //   row3: SW4  S1.5 S1.4 S1.2 S1.1 S1.3
    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        rows = <6>;
        columns = <6>;

        map = <RC(1,0) RC(5,0) RC(3,1) RC(0,2) RC(4,2) RC(1,3) RC(5,3)
               RC(2,0) RC(0,1) RC(4,1) RC(1,2) RC(5,2) RC(2,3) RC(0,5)
               RC(3,0) RC(2,1) RC(5,1) RC(3,2) RC(0,3) RC(4,3) RC(1,5)
               RC(4,0) RC(3,4) RC(2,4) RC(1,4) RC(0,4) RC(5,4)>;
    };
};
