// tunotuno keymap -- TEMPORARY: right half only (27 keys).
// Thumb switch (5 directions) = &mo 1. Layer 1 is a placeholder.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL  &kp BSPC
                &kp Y   &kp U   &kp I   &kp O   &kp P      &kp LBKT   &kp RBKT
                &kp H   &kp J   &kp K   &kp L   &kp SEMI   &kp SQT    &kp RET
                &kp N   &mo 1   &mo 1   &mo 1   &mo 1      &mo 1
            >;
        };

        layer_1 {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
