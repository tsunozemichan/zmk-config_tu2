// tunotuno keymap -- TEMPORARY: right half only (27 keys).
// Thumb switch (5 directions) = &mo 1. Layer 1 is a placeholder.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp BSPC    &kp Y   &kp U   &kp I      &kp O    &kp P      &kp AT
                &kp SPC     &kp H   &kp J   &kp K      &kp L    &kp SEMI   &kp COLON
                &kp ENTER   &kp N   &kp M   &kp COMMA  &kp DOT  &kp SLASH  &kp INT1
                &kp GRAVE   &mo 1   &mo 1   &mo 1      &mo 1    &mo 1
            >;
        };

        layer_1 {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
