// tunotuno keymap -- TEMPORARY: right half only (27 keys).
// Thumb switch (5 directions) = &mo 1. Layer 1 is a placeholder.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp BSPC    &kp ESC  &kp Y   &kp U   &kp I     &kp O      &kp BSPC
                &kp SPC     &kp U    &kp H   &kp J   &kp K     &kp L      &kp RET
                &kp RET     &kp J    &kp N   &kp M   &kp COMMA &kp DOT    &kp ESC
                &kp GRAVE   &mo 1    &mo 1   &mo 1   &mo 1     &mo 1
            >;
        };

        layer_1 {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
